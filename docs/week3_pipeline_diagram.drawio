<mxfile host="app.diagrams.net"><diagram id="w3pipe" name="Week 3 V1 Data Pipeline"><mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1000" landscape="1" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;WattLah: Week 3 V1 Data Pipeline&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1500" height="32" as="geometry"/></mxCell><mxCell id="sub" value="Expands the two data components of the Week 2 V1 architecture: the Knowledge Source (Pathway A) and the Tariff Rate Table (Pathway B). Arrows are dependencies: data moves on only when the stage before it passes." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1700" height="22" as="geometry"/></mxCell><mxCell id="h0" value="1. SOURCE" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl0" value="" style="line;strokeWidth=2;strokeColor=#999999;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="h1" value="2. INGEST" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="304" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl1" value="" style="line;strokeWidth=2;strokeColor=#999999;html=1;" vertex="1" parent="1"><mxGeometry x="304" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="h2" value="3. INSPECT" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="568" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl2" value="" style="line;strokeWidth=2;strokeColor=#999999;html=1;" vertex="1" parent="1"><mxGeometry x="568" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="h3" value="4. PREPARE / TRANSFORM" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="832" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl3" value="" style="line;strokeWidth=2;strokeColor=#999999;html=1;" vertex="1" parent="1"><mxGeometry x="832" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="h4" value="5. VALIDATE OUTPUT" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1096" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl4" value="" style="line;strokeWidth=2;strokeColor=#999999;html=1;" vertex="1" parent="1"><mxGeometry x="1096" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="h5" value="6. RECORD LINEAGE" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl5" value="" style="line;strokeWidth=2;strokeColor=#999999;html=1;" vertex="1" parent="1"><mxGeometry x="1360" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="h6" value="WEEK 2 COMPONENT" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1624" y="96" width="226" height="22" as="geometry"/></mxCell><mxCell id="hl6" value="" style="line;strokeWidth=2;strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="1624" y="118" width="226" height="6" as="geometry"/></mxCell><mxCell id="la" value="&lt;b&gt;Pathway A: documents&lt;/b&gt; &amp;nbsp;&lt;span style='color:#555'&gt;(FR2, FR4, FR5, RAI1)&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="900" height="24" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b style='font-size:13px'&gt;S02 to S06: 5 PDFs&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;ST statement (BM), TNB releases&lt;br&gt;(2 EN, 3 BM), 3 to 5 pages each&lt;br&gt;Registry row per file: URL, issuer,&lt;br&gt;dates, effective period, SHA-256&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;data/raw/*.pdf, source_registry.csv&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b style='font-size:13px'&gt;Load page by page&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;pypdf layout mode (keeps words&lt;br&gt;whole; plain mode split&lt;br&gt;'c ustomers')&lt;br&gt;SHA-256 must match the registry&lt;br&gt;Page count must match&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cells 3, A3&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="304" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b style='font-size:13px'&gt;Inspect each page&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Characters per page, samples&lt;br&gt;Flag pages with no usable text:&lt;br&gt;S02 p5 (image appendix),&lt;br&gt;S06 p3 (empty)&lt;br&gt;Note S06 table, S05 infographic&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cell A3&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="568" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b style='font-size:13px'&gt;Clean, then chunk&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Remove page furniture, ST&lt;br&gt;letterhead and footer, text after&lt;br&gt;end marker (press phone numbers)&lt;br&gt;Rebuild headings and paragraphs&lt;br&gt;Chunks of whole paragraphs, max&lt;br&gt;1,000 chars, page-bounded&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cells 5A1, B3&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="832" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b style='font-size:13px'&gt;Check the chunks&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Unique chunk_id, text not empty&lt;br&gt;All metadata fields present&lt;br&gt;Page within source, size limit&lt;br&gt;No personal phone numbers&lt;br&gt;Every source produced chunks&lt;br&gt;10/10 key rules kept whole&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;B3 (A); stop on failure&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1096" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b style='font-size:13px'&gt;Store with lineage&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;prepared_text.jsonl: 33 chunks,&lt;br&gt;each with source, page, section,&lt;br&gt;issuer, language, effective dates,&lt;br&gt;processing, SHA-256, status&lt;br&gt;Manifest entries L01 to L05&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cells 5A2, B4.1, 6A, 8A&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b style='font-size:13px'&gt;Knowledge Source&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Official ST and TNB documents,&lt;br&gt;each tagged with issuer, date&lt;br&gt;and effective period&lt;br&gt;Read by Date Aware Retrieval&lt;br&gt;(Topic 7)&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;FR2, FR5, NFR2&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1624" y="168" width="226" height="150" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;Pathway B: tariff table&lt;/b&gt; &amp;nbsp;&lt;span style='color:#555'&gt;(FR1, NFR1, NFR5)&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="900" height="24" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b style='font-size:13px'&gt;S01 schedule + curated CSVs&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;S01: 7-page RP4 tariff schedule&lt;br&gt;tariff_domestic_rp4.csv: 5 rates&lt;br&gt;relief_rules.csv: 6 rules&lt;br&gt;Each row: source ID, page,&lt;br&gt;printed label or evidence text&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;data/raw/*.csv&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b style='font-size:13px'&gt;Load as text&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;pandas, every field read as text&lt;br&gt;so nothing is converted silently&lt;br&gt;Sources must be in the registry&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cell 5B&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="304" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style='font-size:13px'&gt;Inspect the tables&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Shape, empty cells, duplicates&lt;br&gt;Open-ended rules (P01, P05)&lt;br&gt;Threshold overlap: P02 (800 kWh)&lt;br&gt;overrides P01 (600 kWh) for&lt;br&gt;Sep to Dec 2026&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cell 5B&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="568" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b style='font-size:13px'&gt;Verify, then type&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Find each rate in the Domestik Am&lt;br&gt;block of S01 page 1, and each&lt;br&gt;rule's evidence text on its page&lt;br&gt;Numbers to float, dates to ISO,&lt;br&gt;sen/kWh also stored as RM&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cell 5B&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="832" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b style='font-size:13px'&gt;Check the tables&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Unique keys and rule IDs&lt;br&gt;Units in the allowed set&lt;br&gt;Dates in order, pages valid&lt;br&gt;Rows in = rows out&lt;br&gt;100% verified in source&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;B3 (B); stop on failure&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1096" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b style='font-size:13px'&gt;Store with lineage&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;prepared_tariff_rates.csv&lt;br&gt;prepared_relief_rules.csv&lt;br&gt;Manifest entries L06, L07&lt;br&gt;Rerun gives identical&lt;br&gt;SHA-256 (Cell 9)&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;Cells 5B, B4.1, 6A, 8B, 9&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b style='font-size:13px'&gt;Tariff Rate Table&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Rates and thresholds by&lt;br&gt;effective period, each linked&lt;br&gt;to its source document&lt;br&gt;Read by the Bill Calculator&lt;br&gt;Tool (Topic 6 onwards)&lt;/div&gt;&lt;div style='font-size:10px;color:#555555;margin-top:4px'&gt;FR1, NFR1, NFR5&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1624" y="560" width="226" height="150" as="geometry"/></mxCell><mxCell id="ea1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="&lt;b style='font-size:13px'&gt;Failure point 1: explicit&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;A file is missing, or its SHA-256&lt;br&gt;differs from the registry (TNB&lt;br&gt;re-published it). Response: stop.&lt;br&gt;Re-download, or record the new&lt;br&gt;version in the registry.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="304" y="352" width="256" height="120" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b style='font-size:13px'&gt;Failure point 2: silent&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;A page loads but has no text&lt;br&gt;(image or blank page). Response:&lt;br&gt;flag it 'no usable text', keep it&lt;br&gt;out of the chunks, log it. OCR&lt;br&gt;for S02 p5 is left for Topic 4.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="618" y="352" width="246" height="120" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b style='font-size:13px'&gt;Failure point 3: silent&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Fixed-size chunks cut a rule from&lt;br&gt;its qualifier (6 of 10 kept).&lt;br&gt;Response: structure-aware chunks;&lt;br&gt;a key-rule check fails the run&lt;br&gt;if a listed rule is split.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="896" y="352" width="266" height="120" as="geometry"/></mxCell><mxCell id="ef1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="f1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ef2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="f2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ef3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="f3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f4" value="&lt;b style='font-size:13px'&gt;Failure point 4: silent&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;Automatic table parsing lost 4 of 21&lt;br&gt;values on S01 page 1 with no error.&lt;br&gt;Response: curated rows; the run stops&lt;br&gt;if any value is not on its cited page.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="832" y="744" width="286" height="112" as="geometry"/></mxCell><mxCell id="ef4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="f4" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f5" value="&lt;b style='font-size:13px'&gt;Known gap, not a failure yet&lt;/b&gt;&lt;div style='font-size:11px;line-height:1.35;margin-top:4px'&gt;No source states what applies from&lt;br&gt;1 Jan 2027 (P02 just ends), and the&lt;br&gt;Energy Efficiency Incentive tiers are&lt;br&gt;not in any source. Topic 4 data review.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="346" height="112" as="geometry"/></mxCell><mxCell id="ef5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entry