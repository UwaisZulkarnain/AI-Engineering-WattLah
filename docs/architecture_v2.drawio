<mxfile host="Electron" type="device"><diagram id="wattlah-v2" name="Wattlah V2 Architecture"><mxGraphModel dx="1900" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Wattlah: V2 Architecture (after Weeks 3 and 4)&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="1200" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="Components are labelled by capability, not product. Thick borders mark what changed since V1 (Week 2), driven by the data pipeline and the Week 4 quality audit." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1500" height="24" as="geometry"/></mxCell><mxCell id="answer" value="&lt;b style='font-size:14px'&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Figures with working, explanation, source and applicable period&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#555555'&gt;FR1 to FR5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="100" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Household user&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Asks in BM, English or mixed; types billing period dates and kWh&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="170" height="100" as="geometry"/></mxCell><mxCell id="app" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Wattlah Application&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Chat interface&lt;br&gt;Session notice: not TNB, no personal details&lt;br&gt;Billing period check, asks if unclear&lt;br&gt;Coordinates the request&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;FR4, FR6, FR8&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="310" y="370" width="210" height="160" as="geometry"/></mxCell><mxCell id="pii" value="&lt;b style='font-size:14px'&gt;Personal Data Filter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Removes name, address, account, IC and phone numbers before anything leaves the app or is logged&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#555555'&gt;RAI4&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="390" width="190" height="120" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b style='font-size:14px'&gt;Scope / Safety Control&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Detects out of scope requests and returns a refusal with a referral&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#555555'&gt;FR7, RAI5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="390" width="190" height="120" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b style='font-size:14px'&gt;Language Model Service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Understands BM, English and mixed input, requests calculations, writes the answer from retrieved passages and calculator output only&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#555555'&gt;FR2, FR3, FR6, RAI2, RAI3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="390" width="220" height="120" as="geometry"/></mxCell><mxCell id="retr" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Date Aware Retrieval&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Finds chunks in force for each month of the billing period and skips chunks marked superseded&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;FR4, FR5, RAI1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1240" y="170" width="220" height="100" as="geometry"/></mxCell><mxCell id="ks" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Knowledge Source&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Chunks from official ST and TNB PDFs (S02 to S06) and myTNB text (S07, S08) in BM and English, each with source, page or key, effective period and hash&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;FR2, FR5, NFR2, RAI3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="170" width="230" height="100" as="geometry"/></mxCell><mxCell id="calc" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Bill Calculator Tool&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Deterministic port of TNB&#x27;s published method: calendar month split, threshold, AFA, EEI, KWTBB, service tax, rounding. Two labelled results for 2027. No bill that needs an undeclared AFA rate&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;FR1, FR3, NFR1, RAI2&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#b0e3e6;strokeColor=#0e8088;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1240" y="620" width="220" height="100" as="geometry"/></mxCell><mxCell id="rates" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Tariff and Rule Tables&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Rates (S01), monthly AFA, EEI bands and 12 charge rules (S07, S09, S10) by effective period; 2027 threshold as two labelled scenarios&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;FR1, NFR1, NFR5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="620" width="230" height="100" as="geometry"/></mxCell><mxCell id="update" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Source Update and Quality Gate&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Offline pipeline: download, hash, extract, chunk, verify. Release only if provenance passes, all 14 rule groups exist and all reference bills match to the sen&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;NFR1, NFR5, RAI1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="390" width="230" height="120" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Evaluation Point&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Logs redacted input, sources retrieved, calculator inputs and outputs, final answer, latency and tokens for every request. Test sets in evaluation/ (REF-CALC built: 64 reference bills)&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#555555&#x27;&gt;NFR1 to NFR4, RAI1 to RAI5&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontColor=#1a1a1a;spacing=8;verticalAlign=middle;dashed=1;dashPattern=6 4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="310" y="800" width="1500" height="76" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="pii"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pii" target="scope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="scope" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="llm" target="retr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="retr" target="ks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="llm" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="calc" target="rates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="414"/><mxPoint x="1190" y="335"/><mxPoint x="467.5" y="335"/></Array></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="scope" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="600"/><mxPoint x="415" y="600"/></Array></mxGeometry></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="answer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="362.5" y="220"/></Array></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="answer" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="update" target="ks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="update" target="rates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.028;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=2 3;endArrow=none;strokeWidth=1.2;" edge="1" parent="1" source="app" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6933;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=2 3;endArrow=none;strokeWidth=1.2;" edge="1" parent="1" source="calc" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1" value="1. Question,&lt;br&gt;dates, kWh" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="212" y="404" width="96" height="34" as="geometry"/></mxCell><mxCell id="l2" value="2. Question +&lt;br&gt;billing period" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="524" y="404" width="102" height="34" as="geometry"/></mxCell><mxCell id="l3" value="3. Redacted&lt;br&gt;request" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="824" y="404" width="102" height="34" as="geometry"/></mxCell><mxCell id="l4" value="4. In scope&lt;br&gt;request" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1124" y="458" width="112" height="34" as="geometry"/></mxCell><mxCell id="l5" value="5. Query + billing period&lt;br&gt;Chunks, source, period" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1262" y="310" width="176" height="40" as="geometry"/></mxCell><mxCe